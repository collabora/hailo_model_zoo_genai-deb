From: Andrej Shadura <andrew.shadura@collabora.co.uk>
Subject: Prefer system nlohmann-json over fetching from source

The upstream build fetches nlohmann/json over the network via CMake
FetchContent, which isn't acceptable for a Debian build. Try the
system nlohmann-json3-dev package first (3.11.3 in trixie vs the
v3.12.0 pinned upstream -- the API has been stable across this range)
and only fall back to FetchContent if it isn't found.

The code already links against the namespaced nlohmann_json::nlohmann_json
target, which find_package(nlohmann_json) also provides, so no alias is
needed.
---
--- a/cmake/external/json.cmake
+++ b/cmake/external/json.cmake
@@ -2,6 +2,9 @@

 include(FetchContent)

+find_package(nlohmann_json 3.11.3 QUIET)
+if(NOT nlohmann_json_FOUND)
+
 fetchcontent_declare(
     json
     GIT_REPOSITORY https://github.com/nlohmann/json
@@ -16,3 +19,5 @@
     fetchcontent_populate(json)
     add_subdirectory(${json_SOURCE_DIR} ${json_BINARY_DIR} EXCLUDE_FROM_ALL)
 endif()
+
+endif() # nlohmann_json_FOUND
